{
  "name": "GNAT Reader",
  "short_name": "GNAT",
  "description": "Lightweight STIX 2.1 reader — triage and FSA on the go",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "theme_color": "#0b0d10",
  "background_color": "#0b0d10",
  "icons": [
    {
      "src": "/icons/192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "bundle",
          "accept": [
            "application/json",
            "application/stix+json",
            ".json",
            ".stix"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "application/json": [".json", ".stix"],
        "application/stix+json": [".stix"],
        "text/plain": [".stix"]
      }
    }
  ],
  "categories": ["productivity", "utilities"]
}
